# Endereço do LocalStack usado pela API (/api/ses), pelo Vite e pelo script de seed
LOCALSTACK_URL=http://localhost:4566
AWS_REGION=us-east-1
# Porta do servidor de produção (npm start). O Vite (npm run dev) usa a 5175.
PORT=4568
# Onde ficam lidas, estrelas e marcadores (padrão: ./data). O Docker monta a mesma pasta.
# DATA_DIR=./data
